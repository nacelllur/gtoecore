{
  "multipart": [
    {
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub",
        "y": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "gtoecore:block/energy/rotation_axle_stub",
        "x": 90
      }
    }
  ]
}